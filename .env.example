# ---- OmniRoute (OpenAI-compatible gateway) ---------------------------------
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Create an endpoint key in the OmniRoute dashboard (http://localhost:20128) and paste it here
OMNIROUTE_API_KEY=
# Any model id from `veil models` (OmniRoute uses provider/model ids)
VEIL_DEFAULT_MODEL=

# ---- VeilProxy ----------------------------------------------------------------
VEIL_HOST=127.0.0.1
VEIL_PORT=8787
# Optional: require clients of VeilProxy to send "Authorization: Bearer <key>"
VEIL_CLIENT_KEY=
# Auto-lock the vault (wipe master key from memory) after N idle seconds; 0 = never
VEIL_IDLE_LOCK_SECONDS=900
# crypto backend: auto | rust | python
VEIL_CRYPTO_BACKEND=auto

# ---- Optional features --------------------------------------------------------
# Name/place/org detection (needs: pip install ".[nlp]" and a spaCy model)
VEIL_NLP=0
# VEIL_NLP_MODEL=en_core_web_lg
# Route prompts containing these kinds to a local model (e.g. Ollama via OmniRoute)
# VEIL_LOCAL_MODEL=ollama/llama3
# VEIL_LOCAL_ONLY_KINDS=PRIVATEKEY,CARD,SSN,IBAN
# Custom detection rules / allowlist
# VEIL_RULES_FILE=./config/rules.example.yaml
# Where state lives (default ~/.veilproxy)
# VEIL_HOME=
